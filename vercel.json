{
  "version": 2,
  "rewrites": [
    { "source": "/story/:slug", "destination": "/story.html?slug=:slug" },
    { "source": "/stories", "destination": "/stories.html" },
    { "source": "/submit", "destination": "/submit-story.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/login", "destination": "/admin/login.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
